<launch>
  <!-- Load joint controller configurations from YAML file to parameter server -->
  <rosparam file="$(find mycobot_description)/config/mycobot_280_gripper/mycobot_280_gripper_controllers.yaml" command="load"/>

  <!-- load the controllers -->

  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" ns="/firefighter" args="joint2_to_joint1_position_controller joint3_to_joint2_position_controller joint4_to_joint3_position_controller joint5_to_joint4_position_controller joint6_to_joint5_position_controller joint6output_to_joint6_position_controller gripper_controller_position_controller gripper_base_to_gripper_left2_position_controller gripper_left3_to_gripper_left1_position_controller gripper_base_to_gripper_right3_position_controller gripper_base_to_gripper_right2_position_controller gripper_right3_to_gripper_right1_position_controller joint_state_controller"/>

  <!-- convert joint states to TF transforms for rviz, etc -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
    respawn="false" output="screen">
    <remap from="/joint_states" to="/firefighter/joint_states" />
  </node>

</launch>