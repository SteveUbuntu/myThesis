<launch>

    <!-- Launch Gazebo -->
    <!-- Associate to the robot description parameter, the urdf file that model the robot-->
    <param name="robot_description" textfile = "$(find tom_description)/urdf/tom_gazebo_ready.urdf" />

    <!-- Set the position in empty world-->
    <arg name="x" default="0" />
    <arg name="y" default="0" />
    <arg name="z" default="0" />

     <!-- Launch Gezabo world in paused-->
    <include file = "$(find gazebo_ros)/launch/empty_world.launch" >
        <arg name="use_sim_time" value="true"/>
        <arg name="debug" value="false"/>
        <arg name="gui" value="true"/>
        <arg name="paused" value="true" />
    </include> 

    <!-- Spawn the robot using the package gazebo_ros-->
    <node name="spawn_the_robot" pkg="gazebo_ros" type="spawn_model"  output="screen" args="-urdf -param robot_description -model cobot -x $(arg x) -y $(arg y) -z $(arg z)" />

    <!-- Load the node controller manager-->
    <node name="controller_spawner" pkg="controller_manager" type="spawner"  
            output="screen" respawn="false" ns="/tom"
            args="joint_state_controller
                left_arm_controller right_arm_controller
                head_controller
                --timeout 60 ">
    </node>

     <!-- Load the controllers-->
    <rosparam command="load" file="$(find tom_description)/config/tom_joint_states.yaml"/>
    <rosparam command="load" file="$(find tom_description)/config/trajectory_control.yaml"/>

    <!-- Convert joint states to TF transform for rviz and rqt-->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"  
            output="screen" respawn="false">
            <remap from="/joint_states" to="/tom/joint_states"/>
        
    </node>

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <remap from="/joint_states" to="/tom/joint_states"/>

    <include file= "$(find moveit_tom_pkg)/launch/planning_context.launch" >
        <arg name="load_robot_description" value="false" />
    </include>

    <include file= "$(find moveit_tom_pkg)/launch/move_group.launch" >
        <arg name="publish_monitored_planning_scene" value="true" />
    </include>

    <include file= "$(find moveit_tom_pkg)/launch/moveit_rviz.launch" >
        <arg name="rviz_config" value="$(find moveit_tom_pkg)/launch/moveit.rviz" />
    </include>

</launch>