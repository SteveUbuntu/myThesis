<?xml version="1.0"?>
<robot name="tom">

    <material name="red">
        <color rgba="0.8 0 0 1"/>
    </material>

    <material name="green">
        <color rgba="0 0.8 0 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 0.8 1"/>
    </material>

    <material name="cyan">
        <color rgba="0 0.8 0.8 1"/>
    </material>

    <material name="yellow">
        <color rgba="0.8 0.8 0 1"/>
    </material>

    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/tom</robotNamespace>
        </plugin>
    </gazebo>

    <link name="base_link">
    </link>

<!--Torso, Head and Eyes parts-->

    <link name="torso_link">
	    <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.998" />
            <inertia ixx="0.0018" ixy="0.0" ixz="0.0" iyy="0.0018" iyz="0.0" izz="0.0009"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.09"/>
            </geometry>
        </collision>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.09"/>
            </geometry>
            <material name="cyan"/>
        </visual>
    </link>

    <joint name="fixed_joint" type="fixed">
        <parent link="base_link"/>
        <child link="torso_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="torso_link">
        <kp>100000.0</kp>
        <kd>100000.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <material>Gazebo/Turquoise</material>
    </gazebo>

    <link name="head_base_link">
	    <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.111" />
            <inertia ixx="2.520625e-05" ixy="0.0" ixz="0.0" iyy="2.520625e-05" iyz="0.0" izz="4.995e-05"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.005"/>
            </geometry>
        </collision>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <gazebo reference="head_base_link">
        <kp>100000.0</kp>
        <kd>100000.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="head_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="head_base_link"/>
        <origin xyz="0 0 0.0475" rpy="0 0 0"/>
    </joint>

    <gazebo reference="roll_M1_link">
        <kp>1000.0</kp>
        <kd>10.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <material>Gazebo/Red</material>
    </gazebo>

    <link name="head_link">
	    <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.666" />
            <inertia ixx="0.0001998" ixy="0.0" ixz="0.0" iyy="0.0001998" iyz="0.0" izz="0.0002997"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
        </collision>
        <visual>
