<robot name="simple_box" >
    <link name="world"/>
  <joint name="world_to_table=" type="fixed">
        <parent link="world" />
        <child link="my_box" />
  </joint>
    <link name="my_box" >
        <inertial>
            <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0010833333333333333" ixy="0.0" ixz="0.0" iyy="0.0006666666666666668" iyz="0.0" izz="0.0010833333333333333"/>
        </inertial>
        <visual>
            <origin xyz = "0 0 0" />
            <geometry>
                <box size="0.2 0.3 0.2"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz = "0 0 0.1" />
            <geometry>
                <box size="0.2 0.3 0.2"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="my_box" >
        <material>Gazebo/Black</material>
    </gazebo>

</robot>