    <link name="left_eye_monitor_link">
	    <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.00444" />
            <inertia ixx="1.5799000000000003e-07" ixy="0.0" ixz="0.0" iyy="1.5799000000000003e-07" iyz="0.0" izz="1.998e-08"/>
