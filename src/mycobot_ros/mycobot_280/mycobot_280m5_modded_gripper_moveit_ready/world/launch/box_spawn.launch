<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <include file="$(find xacro)/xacro --inorder $(find mycobot_280m5_modded_gripper_moveit_ready)/world/urdf/box.urdf">
    <!-- Set the position of the cube_1 in empty world-->
    <arg name="x_c1" default="0" />
    <arg name="y_c1" default="0.28" />
    <arg name="z_c1" default="0.025" />

    <!-- Set the position of the cube_2 in empty world-->
    <arg name="x_c2" default="0.28" />
    <arg name="y_c2" default="0.0" />
    <arg name="z_c2" default="0.025" />
    <arg name="Y_c2" default="1.57" />
        <arg 
        name="urdf_robot_file"
        value="$(find xacro)/xacro --inorder $(find mycobot_280m5_modded_gripper_moveit_ready)/world/urdf/box.urdf"
        />
        <arg name="robot_name" value="simple_box" />
    </include>

    <!-- Spawn the cube_1 using the package gazebo_ros-->
    <node name="spawn_the_cube_1" pkg="gazebo_ros" type="spawn_model"  output="screen" args="-urdf -param cube -model box_1 -x $(arg x_c1) -y $(arg y_c1) -z $(arg z_c1)" />

    <!-- Spawn the cube_2 using the package gazebo_ros-->
    <node name="spawn_the_cube_2" pkg="gazebo_ros" type="spawn_model"  output="screen" args="-urdf -param cube -model box_2 -x $(arg x_c2) -y $(arg y_c2) -z $(arg z_c2) -Y $(arg Y_c2)" />
</launch>