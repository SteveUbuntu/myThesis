<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <include file="$(find tom_description)/launch/tom_spawn_urdf.launch">
        <arg name="x" value="0.0" />
        <arg name="y" value="0.0" />
        <arg name="z" value="1.65" />
        <arg 
        name="urdf_robot_file"
        value="$(find tom_description)/urdf/tom_gazebo_ready.urdf"
        />
        <arg name="robot_name" value="tom" />
    </include>
</launch>