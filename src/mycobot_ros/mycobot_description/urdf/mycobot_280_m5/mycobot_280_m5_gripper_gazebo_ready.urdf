    <link name="world" />
    <link name="g_base">
        <visual>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae" />
            </geometry>
            <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae" />
            </geometry>
            <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708" />
        </collision>
        <inertial>
            <mass value="1000" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </inertial>
    </link>
    <joint name="world_to_g_base=" type="fixed">
        <parent link="world" />
        <child link="g_base" />
    </joint>
    <gazebo reference="g_base">
        <kp>100000.0</kp>
        <kd>100000.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
    </gazebo>
