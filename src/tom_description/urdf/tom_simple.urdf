<?xml version="1.0"?>
<robot name="tom">

    <material name="red">
        <color rgba="0.8 0 0 1"/>
    </material>

    <material name="green">
        <color rgba="0 0.8 0 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 0.8 1"/>
    </material>

    <material name="cyan">
        <color rgba="0 0.8 0.8 1"/>
    </material>

    <material name="yellow">
        <color rgba="0.8 0.8 0 1"/>
    </material>

    <link name="base_link">
        <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
        <material name="red"/>
        </visual>
    </link>

<!--Torso, Head and Eyes parts-->

    <link name="torso_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.09"/>
            </geometry>
            <material name="cyan"/>
        </visual>
    </link>

    <joint name="fixed_joint" type="fixed">
        <parent link="base_link"/>
        <child link="torso_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="head_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="head_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="head_base_link"/>
        <origin xyz="0 0 0.0475" rpy="0 0 0"/>
    </joint>

    <link name="head_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
            <material name="cyan"/>
        </visual>
    </link>

    <joint name="head_joint" type="continuous">
        <parent link="head_base_link"/>
        <child link="head_link"/>
        <origin xyz="0 0 0.0175" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_eye_link">
        <visual>
            <origin rpy="1.57 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_eye_base_joint" type="fixed">
        <parent link="head_link"/>
        <child link="left_eye_link"/>
        <origin xyz="0.01 0.025 0.007" rpy="0 0 0"/>
    </joint>

    <link name="right_eye_link">
        <visual>
            <origin rpy="1.57 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_eye_base_joint" type="fixed">
        <parent link="head_link"/>
        <child link="right_eye_link"/>
        <origin xyz="-0.01 0.025 0.007" rpy="0 0 0"/>
    </joint>

    <link name="left_eye_monitor_link">
        <visual>
            <origin rpy="1.57 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.003" length="0.02"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>

    <joint name="left_eye_monitor_joint" type="prismatic">
        <parent link="left_eye_link"/>
        <child link="left_eye_monitor_link"/>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <limit lower="0" upper="0.01" effort="0.1" velocity="0.005"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_eye_monitor_link">
        <visual>
            <origin rpy="1.57 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.003" length="0.02"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>

    <joint name="right_eye_monitor_joint" type="prismatic">
        <parent link="right_eye_link"/>
        <child link="right_eye_monitor_link"/>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <limit lower="0" upper="0.01" effort="0.1" velocity="0.005"/>
        <axis xyz="0 1 0"/>
    </joint>

<!--Arms, Foreamrs and Wrists-->

    <link name="left_arm_base_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.007" length="0.002"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_arm_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="left_arm_base_link"/>
        <origin xyz="0.03 0 0.03" rpy="0 0 0"/>
    </joint>

    <link name="right_arm_base_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.007" length="0.002"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_arm_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="right_arm_base_link"/>
        <origin xyz="-0.03 0 0.03" rpy="0 0 3.14"/>
    </joint>

    <link name="left_arm_ball_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.004"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link> 

    <joint name="left_arm_ball_joint" type="revolute">
        <parent link="left_arm_base_link"/>
        <child link="left_arm_ball_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <limit lower="-1" upper="1" effort="0.1" velocity="0.005"/>
        <axis xyz="1 0 0"/>
    </joint>

    <link name="left_arm_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0.0225 0 0"/>
            <geometry>
                <cylinder radius="0.002" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_arm_joint" type="revolute">
        <parent link="left_arm_ball_link"/>
        <child link="left_arm_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <limit lower="-1" upper="1.3" effort="0.1" velocity="0.005"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_arm_ball_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.004"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link> 

    <joint name="right_arm_ball_joint" type="revolute">
        <parent link="right_arm_base_link"/>
        <child link="right_arm_ball_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <limit lower="-1" upper="1" effort="0.1" velocity="0.005"/>
        <axis xyz="1 0 0"/>
    </joint>

    <link name="right_arm_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0.0225 0 0"/>
            <geometry>
                <cylinder radius="0.002" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_arm_joint" type="revolute">
        <parent link="right_arm_ball_link"/>
        <child link="right_arm_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <limit lower="-1" upper="1.3" effort="0.1" velocity="0.005"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_forearm_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.003" length="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_forearm_base_joint" type="fixed">
        <parent link="left_arm_link"/>
        <child link="left_forearm_base_link"/>
        <origin xyz="0.045 0 0" rpy="0 0 0"/>
    </joint>

    <link name="right_forearm_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.003" length="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_forearm_base_joint" type="fixed">
        <parent link="right_arm_link"/>
        <child link="right_forearm_base_link"/>
        <origin xyz="0.045 0 0" rpy="0 0 0"/>
    </joint>


    <link name="left_forearm_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0.0225 0 0"/>
            <geometry>
                <cylinder radius="0.002" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_frearm_joint" type="revolute">
        <parent link="left_forearm_base_link"/>
        <child link="left_forearm_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <limit lower="0" upper="2" effort="0.1" velocity="0.005"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_forearm_link">
        <visual>
            <origin rpy="0 1.57 0" xyz="0.0225 0 0"/>
            <geometry>
                <cylinder radius="0.002" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_forearm_joint" type="revolute">
        <parent link="right_forearm_base_link"/>
        <child link="right_forearm_link"/>
        <origin xyz="0 0 0" rpy="3.14 0 0"/>
        <limit lower="0" upper="2" effort="0.1" velocity="0.005"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wrist_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_wrist_base_joint" type="fixed">
        <parent link="left_forearm_link"/>
        <child link="left_wrist_base_link"/>
        <origin xyz="0.045 0 0" rpy="0 0 0"/>
    </joint>

    <link name="right_wrist_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_wrist_base_joint" type="fixed">
        <parent link="right_forearm_link"/>
        <child link="right_wrist_base_link"/>
        <origin xyz="0.045 0 0" rpy="0 0 0"/>
    </joint>

<!--Legs-->

    <link name="left_leg_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.007" length="0.002"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_leg_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="left_leg_base_link"/>
        <origin xyz="0.01 0 -0.045" rpy="0 0 0"/>
    </joint>

    <link name="right_leg_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.007" length="0.002"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_leg_base_joint" type="fixed">
        <parent link="torso_link"/>
        <child link="right_leg_base_link"/>
        <origin xyz="-0.01 0 -0.045" rpy="0 0 0"/>
    </joint>

    <link name="left_leg_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.0225"/>
            <geometry>
                <cylinder radius="0.005" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_leg_joint" type="fixed">
        <parent link="left_leg_base_link"/>
        <child link="left_leg_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="right_leg_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.0225"/>
            <geometry>
                <cylinder radius="0.005" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_leg_joint" type="fixed">
        <parent link="right_leg_base_link"/>
        <child link="right_leg_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="left_knee_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.02"/>
            <geometry>
                <cylinder radius="0.003" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_knee_joint" type="prismatic">
        <parent link="left_leg_link"/>
        <child link="left_knee_link"/>
        <origin xyz="0 0 -0.045" rpy="0 0 0"/>
        <limit lower="0" upper="0.03" effort="0.1" velocity="0.005"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_knee_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.02"/>
            <geometry>
                <cylinder radius="0.003" length="0.045"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_knee_joint" type="prismatic">
        <parent link="right_leg_link"/>
        <child link="right_knee_link"/>
        <origin xyz="0 0 -0.045" rpy="0 0 0"/>
        <limit lower="0" upper="0.03" effort="0.1" velocity="0.005"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_foot_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.003"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_foot_base_joint" type="fixed">
        <parent link="left_knee_link"/>
        <child link="left_foot_base_link"/>
        <origin xyz="0 0 -0.0425" rpy="0 0 0"/>
    </joint>

    <link name="right_foot_base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.003"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_foot_base_joint" type="fixed">
        <parent link="right_knee_link"/>
        <child link="right_foot_base_link"/>
        <origin xyz="0 0 -0.0425" rpy="0 0 0"/>
    </joint>

    <link name="left_foot_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0.005 0"/>
            <geometry>
                <box size="0.015 0.025 0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="left_foot_joint" type="fixed">
        <parent link="left_foot_base_link"/>
        <child link="left_foot_link"/>
        <origin xyz="0 0 -0.00325" rpy="0 0 0"/>
    </joint>

    <link name="right_foot_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0.005 0"/>
            <geometry>
                <box size="0.015 0.025 0.005"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="right_foot_joint" type="fixed">
        <parent link="right_foot_base_link"/>
        <child link="right_foot_link"/>
        <origin xyz="0 0 -0.00325" rpy="0 0 0"/>
    </joint>

</robot>