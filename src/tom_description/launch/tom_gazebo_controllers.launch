<launch>
  <!-- Load joint controller configurations from YAML file to parameter server -->
  <rosparam file="$(find tom_description)/config/tom_controllers.yaml" command="load"/>

  <!-- load the controllers -->

  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" ns="/tom" args="head_joint_position_controller left_eye_monitor_joint_position_controller right_eye_monitor_joint_position_controller left_arm_ball_joint_position_controller left_arm_joint_position_controller right_arm_ball_joint_position_controller right_arm_joint_position_controller left_forearm_joint_position_controller right_forearm_joint_position_controller left_knee_joint_position_controller right_knee_joint_position_controller  joint_state_controller"/>

  <!-- convert joint states to TF transforms for rviz, etc -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
    respawn="false" output="screen">
    <remap from="/joint_states" to="/tom/joint_states" />
  </node>

</launch>